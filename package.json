{
  "name": "tripsalesagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tripsalesagent/app dev",
    "build": "pnpm --filter @tripsalesagent/app build",
    "preview": "pnpm --filter @tripsalesagent/app preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm build && pnpm test:integration:run",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migration:create": "pnpm --filter @tripsalesagent/database migration:create",
    "db:migration:up": "pnpm --filter @tripsalesagent/database migration:up",
    "db:migration:down": "pnpm --filter @tripsalesagent/database migration:down",
    "db:migration:pending": "pnpm --filter @tripsalesagent/database migration:pending"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "^2.5.1",
    "agent-browser": "0.39.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
